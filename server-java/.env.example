# Existing Prisma-style URLs are converted to JDBC automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english
SECRET_KEY=replace-with-the-same-secret-as-server

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
