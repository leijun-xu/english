ALIPAY_PUBLIC_KEY=
ALIPAY_PRIVATE_KEY=
ALIPAY_NOTIFY_URL=http://localhost:3000

SERVER_PORT=3000
SOCKET_ENABLED=true
SOCKET_HOST=0.0.0.0
SOCKET_PORT=3002
